{
  "name": "jsx-ast-utils-x",
  "version": "0.1.0",
  "type": "module",
  "description": "AST utility module for statically analyzing JSX",
  "repository": "git+https://github.com/eslinter/jsx-ast-utils-x.git",
  "author": "Ethan Cohen",
  "maintainers": [
    "JounQin <admin@1stg.me> (https://www.1stG.me)"
  ],
  "license": "MIT",
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./elementType": "./elementType.js",
    "./eventHandlers": "./eventHandlers.js",
    "./eventHandlersByType": "./eventHandlersByType.js",
    "./getLiteralPropValue": "./getLiteralPropValue.js",
    "./getProp": "./getProp.js",
    "./getPropValue": "./getPropValue.js",
    "./hasAnyProp": "./hasAnyProp.js",
    "./hasEveryProp": "./hasEveryProp.js",
    "./hasProp": "./hasProp.js",
    "./propName": "./propName.js"
  },
  "files": [
    "elementType.js",
    "eventHandlers.js",
    "eventHandlersByType.js",
    "getLiteralPropValue.js",
    "getProp.js",
    "getPropValue.js",
    "hasAnyProp.js",
    "hasEveryProp.js",
    "hasProp.js",
    "propName.js",
    "src"
  ],
  "keywords": [
    "jsx",
    "ast",
    "lint",
    "eslint",
    "jsx-ast-utils"
  ],
  "scripts": {
    "build": "echo \"No build step needed until TypeScript migration\"",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "simple-git-hooks && yarn-berry-deduplicate || exit 0",
    "release": "yarn build && clean-pkg-json && changeset publish",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest --coverage",
    "test:watch": "yarn test --watch"
  },
  "devDependencies": {
    "@1stg/common-config": "^14.0.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "@commitlint/cli": "^19.8.1",
    "@types/jest": "^29.5.14",
    "clean-pkg-json": "^1.3.0",
    "encoding": "^0.1.13",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import-x": "^4.12.2",
    "eslint-plugin-jest": "^28.11.0",
    "flow-parser": "^0.271.0",
    "globals": "^16.1.0",
    "in-publish": "^2.0.1",
    "jest": "^29.7.0",
    "nano-staged": "^0.8.0",
    "npm-run-all2": "^8.0.2",
    "prettier": "^3.5.3",
    "psl": "^1.15.0",
    "simple-git-hooks": "^2.13.0",
    "size-limit": "^11.2.0",
    "size-limit-preset-node-lib": "^0.4.0",
    "yarn-berry-deduplicate": "^6.1.3"
  },
  "resolutions": {
    "prettier": "^3.5.3"
  }
}
